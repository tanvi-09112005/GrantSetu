# ---------------------------------------------------------------------------
# GrantSetu — environment template. Copy to .env and fill in. Never commit .env
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (used by seed/eval scripts and pgvector queries)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Gemini -----------------------------------------------------------------
# NEVER hardcode model strings in node code (Addendum section 3).
# Re-check https://ai.google.dev/gemini-api/docs/deprecations before each phase kickoff.
GOOGLE_API_KEY=
GEMINI_PRO_MODEL=gemini-3.1-pro
GEMINI_FLASH_MODEL=gemini-3.8-flash

# --- Embeddings -------------------------------------------------------------
# BGE-M3 is 1024-dim. If the week-1 compute check fails, fall back to
# BAAI/bge-small-en-v1.5 (384) and update EMBEDDING_DIM + the migration.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=auto

# --- Retrieval / verification tuning ---------------------------------------
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_FINAL_K=5
RRF_K=60
CHUNK_TOKENS=350
CHUNK_OVERLAP=60
FABRICATION_THRESHOLD=0.10
MAX_REVISION_CYCLES=2

# --- App --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
